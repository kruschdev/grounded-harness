# --- HTTP Control Gateway ---
# Optional: TCP listen port and structured service identifier
PORT=3782
SERVICE_NAME=krusch-grounded-harness

# --- Persistence & OS Drive Protection (INV-LEGO-04) ---
# Optional: Point DATA_DIR and DB_PATH to a dedicated non-OS storage volume in production
DATA_DIR=./data
DB_PATH=./data/app.db

# --- Structured Logging ---
# Optional: Directory for rotating JSON application logs
LOG_DIR=./logs
